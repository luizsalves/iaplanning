ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pelo agente. Padrao: claude-opus-5. Para um piloto de baixo
# custo, claude-sonnet-5 tambem funciona bem com esse conjunto de ferramentas.
CLAUDE_MODEL=claude-opus-5

# Data usada como "hoje" pelos indicadores. Os dados fake em data/contas_a_pagar.csv
# foram criados com referencia a 2026-09-21. Se nao definir, o agente usa a
# data real do sistema (o que pode deixar os dados fake sem sentido).
CONTAS_A_PAGAR_DATA_REF=2026-09-21
